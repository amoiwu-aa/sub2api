{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // 默认会把 vite.config.js 输出到源文件旁边，而 Vite 解析配置时 .js 优先于
    // .ts，过期产物会静默遮蔽真正的配置源。产物统一放进 node_modules/.tmp。
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig-node/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
